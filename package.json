{
  "name": "eyewall-api",
  "version": "1.0.0",
  "private": true,
  "description": "Public, versioned API for EyeWall Analytics' own hockey models (Elo, win probabilities, playoff odds, model scorecard), with an OpenAPI 3.1 spec generated from code.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src/ test/ scripts/",
    "lint:spec": "redocly lint openapi.json --format=stylish",
    "spec": "node scripts/write-openapi.js",
    "spec:check": "node scripts/write-openapi.js --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.21",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.82.0",
    "eslint": "^10.15.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": true
  }
}
